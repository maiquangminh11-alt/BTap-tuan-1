#include <iostream>
#include <vector>
using namespace std;

void locTrungBinhCong(const vector<double>& a) {
    int n = a.size();
    if (n == 0) return;
    // ktra mảng rỗng thì dừng hàm

    vector<double> b(n); // tạo mảng b cùng kích thước để lưu kết quả

    b[0] = a[0];
    b[n - 1] = a[n - 1];
    // giữ nguyên 2 phần tử đầu và cuối vì ko đủ 3 số kề nhau

    for (int i = 1; i < n - 1; i++) {
        b[i] = (a[i - 1] + a[i] + a[i + 1]) / 3.0;
    }
    // cộng 3 số kề nhau rồi chia cho 3.0 để lấy trung bình cộng số thực

    cout << "Mang sau khi loc: ";
    for (int i = 0; i < n; i++) {
        cout << b[i] << " ";
    }
    cout << endl;
    // in mảng b sau khi đã lọc
}

int main() {
    int n;
    cin >> n;

    vector<double> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    locTrungBinhCong(a);

    return 0;
}
// độ phức tạp thời gian: O(N) do dùng vòng lặp duyệt qua N phần tử của mảng
// độ phức tạp bộ nhớ: O(N) do tạo thêm vector b gồm N phần tử để lưu kết quả
