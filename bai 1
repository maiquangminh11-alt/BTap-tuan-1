#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cout << "Nhap N: ";
    cin >> n;

    vector<int> a(n); \\ tạo mảng động
    long long sum = 0; \\ dùng long long để tránh tràn bit

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
    }
\\ tạo vòng lặp bắt đầu từ gtrị đầu đến cuối của mảng, mỗi vòng lặp nhập giá trị sau đó cộng vào sum.
    cout << "Tong = " << sum << endl;
    return 0;
}
\\ độ phức tạp thời gian: O(N) do mảng lặp n lần
\\ độ phức tạp bộ nhớ: O(N) do mảng tạo n ô nhớ
