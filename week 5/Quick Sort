int partitionRange(vector<int>& a, int left, int right) {
    int pivot = a[left];
    int i = left;

    for (int j = left + 1; j <= right; ++j) {
        if (a[j] <= pivot) {
            ++i;
            swap(a[i], a[j]);
        }
    }

    swap(a[left], a[i]);
    return i; // Vị trí cuối cùng của chốt.
}

void quickSortRange(vector<int>& a, int left, int right) {
    if (left >= right) return;

    int p = partitionRange(a, left, right);

    quickSortRange(a, left, p - 1);
    quickSortRange(a, p + 1, right);
}

void quickSort(vector<int>& a) {
    if (a.empty()) return;
    quickSortRange(a, 0, static_cast<int>(a.size()) - 1);
}
